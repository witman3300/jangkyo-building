rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade == 'admin';
    }
    // 최고관리자 보호: protected:true 인 계정은 앱(다른 관리자 포함)에서 등급 변경·삭제가
    // 원천적으로 불가능하다. 오직 Firebase 콘솔에서 직접 수정하는 방법만 남는다.
    function isProtected() {
      return ('protected' in resource.data) && resource.data.protected == true;
    }

    // 회원 프로필: 본인 또는 관리자만 읽기 가능. 가입 시 승인 상태를 스스로 true로 못 만들도록 강제한다.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.grade == 'normal'
        && request.resource.data.approved == (request.resource.data.requestedSpecial == false);
      allow update: if isProtected()
        ? (isOwner(uid)
            && request.resource.data.grade == resource.data.grade
            && request.resource.data.approved == resource.data.approved
            && request.resource.data.id == resource.data.id
            && request.resource.data.requestedSpecial == resource.data.requestedSpecial
            && request.resource.data.protected == resource.data.protected)
        : (isAdmin()
            || (isOwner(uid)
                && request.resource.data.grade == resource.data.grade
                && request.resource.data.approved == resource.data.approved
                && request.resource.data.id == resource.data.id
                && request.resource.data.requestedSpecial == resource.data.requestedSpecial));
      allow delete: if !isProtected() && isAdmin();
    }

    // 아이디(로그인용) -> {uid, email} 매핑. 로그인 전 이메일 조회에 필요해 단건 조회(get)만 공개한다.
    // list(목록 나열)는 막아서 전체 회원 아이디를 긁어갈 수 없게 한다.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 이메일 -> {id} 매핑. 아이디 찾기(정확한 본인 이메일을 아는 사람만 조회 가능)에 사용.
    match /emails/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
