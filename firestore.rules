rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade == 'admin';
    }
    // 특별회원 권한: 승인된 특별회원 또는 관리자 (회원광장 게시판 열람·작성 기준)
    function isSpecialMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade in ['special', 'admin'];
    }
    // 최고관리자 보호: protected:true 인 계정은 앱(다른 관리자 포함)에서 등급 변경·삭제가
    // 원천적으로 불가능하다. 오직 Firebase 콘솔에서 직접 수정하는 방법만 남는다.
    function isProtected() {
      return ('protected' in resource.data) && resource.data.protected == true;
    }

    // 회원 프로필: 본인 또는 관리자만 읽기 가능.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      /* 가입 시 스스로 승인 상태를 만들 수 없게 강제한다.
         신규 가입자는 등급과 무관하게 승인대기(approved=false)로만 만들 수 있고,
         승인된 상태로 만들 수 있는 것은 구회원 명단(legacyMembers)에 있는 아이디뿐이다. */
      allow create: if isOwner(uid)
        && request.resource.data.grade == 'normal'
        && (request.resource.data.approved == false
            || exists(/databases/$(database)/documents/legacyMembers/$(request.resource.data.id)));
      allow update: if isProtected()
        ? (isOwner(uid)
            && request.resource.data.grade == resource.data.grade
            && request.resource.data.approved == resource.data.approved
            && request.resource.data.id == resource.data.id
            && request.resource.data.requestedSpecial == resource.data.requestedSpecial
            && request.resource.data.protected == resource.data.protected)
        : (isAdmin()
            || (isOwner(uid)
                && request.resource.data.grade == resource.data.grade
                && request.resource.data.approved == resource.data.approved
                && request.resource.data.id == resource.data.id
                && request.resource.data.requestedSpecial == resource.data.requestedSpecial));
      allow delete: if !isProtected() && isAdmin();
    }

    // 아이디(로그인용) -> {uid, email} 매핑. 로그인 전 이메일 조회에 필요해 단건 조회(get)만 공개한다.
    // list(목록 나열)는 막아서 전체 회원 아이디를 긁어갈 수 없게 한다.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 이메일 -> {id} 매핑. 아이디 찾기(정확한 본인 이메일을 아는 사람만 조회 가능)에 사용.
    match /emails/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /* 구회원 아이디 선점 명단 (구 사이트 janggyo.co.kr 회원).
       구회원은 비밀번호가 남아 있지 않아 계정을 대신 만들어 줄 수 없다. 아이디만 등록해 두고
       본인 아이디로 가입하면 승인 없이 바로 이용하게 한다.
       usernames와 같은 이유로 단건 조회(get)만 열고 목록 나열(list)은 막는다. */
    match /legacyMembers/{memberId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 페이지 본문 수정 내용(관리자가 사이트에서 직접 고친 화면).
    // 모든 방문자에게 같은 화면이 보여야 하므로 읽기는 공개하고, 쓰기는 관리자만 허용한다.
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* 게시판 글.
       공개(누구나 열람): 임대안내(rental)와 정보마당 4개 게시판
         — notice 공지사항, infodata 자료실, forms 서식 다운로드, faq 자주 묻는 질문
       특별회원 전용: 회원광장(info, data, report, minutes, fee)
       목록 조회는 앱이 항상 cat으로 걸러 읽으므로 이 규칙으로 카테고리별 접근이 통제된다.
       관리사무소 공식 자료를 싣는 게시판(정보마당 전체 + 회원광장 공지·결산·회의록·관리비)은
       관리자만 등록할 수 있다. 임대안내·회원광장 자료실은 특별회원도 올릴 수 있다. */
    match /posts/{postId} {
      allow read: if resource.data.cat in ['rental', 'notice', 'infodata', 'forms', 'faq']
        || isSpecialMember();
      allow create: if isSpecialMember()
        && request.resource.data.authorUid == request.auth.uid
        && (!(request.resource.data.cat in ['info', 'report', 'minutes', 'fee',
              'notice', 'infodata', 'forms', 'faq']) || isAdmin());
      // 글쓴이 본인과 관리자만 수정·삭제 (상단 고정은 관리자만)
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // 실회원 명단에 관리자가 기록하는 등급·승인·가입년월일·최근 로그인·숨김 여부.
    // 개인정보가 섞인 관리용 기록이므로 관리자만 읽고 쓸 수 있다.
    match /memberMeta/{memberId} {
      allow read, write: if isAdmin();
    }

    /* 실회원 명단 본체 (이름·호수·가입일 등). 문서ID = 회원 아이디.
       예전에는 real-members-data.js 파일로 두었는데, 화면은 관리자만 볼 수 있어도
       파일 자체는 주소만 알면 누구나 내려받을 수 있었다. 개인정보라 관리자만 읽게 옮긴다. */
    match /realMembers/{memberId} {
      allow read, write: if isAdmin();
    }
  }
}
